{
  "name": "dsh-cad-design",
  "description": "Parametric CAD tools for the DeepSeek Harness: CadQuery modeling, STEP export, and design preview",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Mrdifferent2022 (https://github.com/Mrdifferent2022)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrdifferent2022/dsh-cad.git"
  },
  "homepage": "https://github.com/Mrdifferent2022/dsh-cad#readme",
  "bugs": "https://github.com/Mrdifferent2022/dsh-cad/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "runners/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-attachment": ">=0.0.1-rc.1 <1.0.0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <1.0.0",
    "@deepseek-ai/dsh-skill": ">=0.0.1-rc.1 <1.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <1.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-attachment": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-skill": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-code-runtime": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-scope": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.0.1-rc.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cad",
    "cadquery",
    "step",
    "mechanical-design",
    "parametric-modeling"
  ]
}
